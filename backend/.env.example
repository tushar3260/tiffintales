# ============================================
# Tiffin Tales Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tiffintales?retryWrites=true&w=majority

# JWT Secret — use a long random string (e.g. openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here

# Server port — must match frontend/vite.config.js proxy target
PORT=5000

# Node environment (development | production)
NODE_ENV=development

# Frontend URL (used in CORS and reset-password email links)
FRONTEND_URL=http://localhost:5173

# Resend.com API key for sending emails (OTP + password reset)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay payment gateway credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Send email confirmation after OTP verify / password reset
SEND_OTP_CONFIRMATION=false
SEND_CONFIRMATION_EMAIL=false

# Google OAuth Client ID (same as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
