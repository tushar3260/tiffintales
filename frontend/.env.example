# ============================================
# Tiffin Tales Frontend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Backend API base URL
# For local development, the Vite proxy handles /api -> localhost:5000
# So you only need the /api prefix, not the full URL
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Razorpay publishable key (same as backend RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Cloudinary config (if using cloudinary for image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
